# deploy/docker-compose.prod.yml 使用的部署参数模板。
# 服务器上首次部署时由 deploy.sh 复制为 .env，按实际路径修改。

# 后端环境变量文件（沿用现有生产 .env，含 PORT/DB/REDIS/JWT 等，不入库）
ESPORTS_SERVER_ENV_FILE=/www/wwwroot/esports.muyuhen.com/server/.env

# 本地上传文件持久化目录（沿用现有目录，升级不丢文件）
ESPORTS_UPLOADS_DIR=/www/wwwroot/esports.muyuhen.com/server/uploads

# 管理端/C 端容器监听的宿主机端口（仅 127.0.0.1，由宿主机 Nginx 反代）
ESPORTS_WEB_PORT=8080
ESPORTS_CLIENT_PORT=8081

# 后端健康检查端口（须与后端 .env 的 PORT 一致）
ESPORTS_SERVER_PORT=3012
