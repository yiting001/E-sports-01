# Compose host bindings
HOST_BIND=127.0.0.1
SERVER_HOST_PORT=3003
WEB_HOST_PORT=8080
CLIENT_HOST_PORT=8081

# PostgreSQL bootstrap credentials
POSTGRES_USER=infra
POSTGRES_PASSWORD=change_me_database_password
POSTGRES_DB=infra_platform

# Keep schema synchronization disabled; apply the committed migrations before startup.
DB_SYNCHRONIZE=false
