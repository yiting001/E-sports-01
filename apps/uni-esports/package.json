{
  "name": "@app/uni-esports",
  "version": "0.1.0",
  "private": true,
  "description": "C 端微信小程序（uni-app，仅 mp-weixin）：与 apps/client 同一后端与共享契约",
  "scripts": {
    "dev:mp-weixin": "uni -p mp-weixin",
