# 后端 REST 基础地址（含全局前缀 /api）
VITE_API_BASE_URL=http://127.0.0.1:3000/api
# WebSocket 基础地址（命名空间 /im 在代码中拼接）
VITE_WS_BASE_URL=http://127.0.0.1:3000
# C 端站点地址（租户目录的“访问站点”使用）
VITE_CLIENT_BASE_URL=http://127.0.0.1:5174
# 本地 dev/preview 代理 /static 时使用；生产静态站由 Nginx 反代
VITE_PROXY_TARGET=http://127.0.0.1:3000
